diff --git a/tools/machines/macro/peaks_glue.cc b/tools/machines/macro/peaks_glue.cc
new file mode 100644
index 0000000..c8ddaed
--- /dev/null
+++ b/tools/machines/macro/peaks_glue.cc
@@ -0,0 +1,101 @@
+/*
+ * Peaks' drum voices as MACRO models (notes/75): BASS DRUM, SNARE DRUM, HI-HAT, FM DRUM, from the module Peaks by
+ * Emilie Gillet (MIT, pichenettes/eurorack, peaks/drums/ and peaks/resources.cc, compiled as is). Integer code at 48 kHz,
+ * the Cycles' rate: no resampling. This file is our glue; the voices are the originals.
+ *
+ * Knobs (COLOR a, SWEEP b, PITCH = note, DECAY = decay; CONTOUR unused):
+ *   BASS DRUM  : PITCH +-7 semitones around the drum's own pitch (note 60 = centre), a TONE, b PUNCH
+ *   SNARE DRUM : PITCH +-7 semitones around the drum's own pitch (note 60 = centre), a TONE, b SNAPPY
+ *   HI-HAT     : no parameter in Peaks (a, b, decay unused: the amp chain of the OS shapes the length)
+ *   FM DRUM    : PITCH = the note (24..96), a FM amount, b NOISE (above half) / OVERDRIVE (below half)
+ * DECAY also drives the drum's own decay (Peaks' DECAY), on top of the OS amp envelope.
+ */
+#include <new>
+#include <stdint.h>
+#include <string.h>
+
+#include "peaks/drums/bass_drum.h"
+#include "peaks/drums/snare_drum.h"
+#include "peaks/drums/fm_drum.h"
+#include "peaks/drums/high_hat.h"
+
+#include "voices.h"
+
+using namespace peaks;
+
+union PeaksVoice {
+	BassDrum bass;
+	SnareDrum snare;
+	HighHat hat;
+	FmDrum fm;
+	PeaksVoice() { }
+	~PeaksVoice() { }
+};
+static_assert(sizeof(PeaksVoice) <= EXT_BYTES, "EXT_BYTES too small for the Peaks drums");
+
+static inline PeaksVoice *V(void *st) { return reinterpret_cast<PeaksVoice *>(st); }
+
+static inline int clampi(int x, int lo, int hi) { return x < lo ? lo : (x > hi ? hi : x); }
+
+/* +-7 semitones around note 60, as the 16-bit frequency parameter of the bass and snare drums */
+static inline int16_t transpose(int note)
+{
+	int d = clampi(note - (60 << 7), -(7 << 7), 7 << 7);
+	return static_cast<int16_t>(clampi(d * 32768 / 896, -32767, 32767));
+}
+
+extern "C" void ext_init(void *st, int kind)
+{
+	/* HighHat::Init and FmDrum::Init leave some fields alone (phases): they expect zeroed memory, as on a fresh module */
+	memset(st, 0, EXT_BYTES);
+	switch (kind) {
+	case 0: new (&V(st)->bass) BassDrum; V(st)->bass.Init(); break;
+	case 1: new (&V(st)->snare) SnareDrum; V(st)->snare.Init(); break;
+	case 2: new (&V(st)->hat) HighHat; V(st)->hat.Init(); break;
+	case 3: new (&V(st)->fm) FmDrum; V(st)->fm.Init(); V(st)->fm.set_sd_range(false); break;
+	}
+}
+
+extern "C" void ext_set(void *st, int kind, int note, int a, int b, int c, int decay)
+{
+	(void)c;
+	uint16_t ua = static_cast<uint16_t>(a * 2), ub = static_cast<uint16_t>(b * 2);
+	uint16_t dec = static_cast<uint16_t>(clampi(decay, 0, 127) * 516);
+	switch (kind) {
+	case 0:
+		V(st)->bass.set_frequency(transpose(note));
+		V(st)->bass.set_tone(ua);
+		V(st)->bass.set_punch(ub);
+		V(st)->bass.set_decay(dec);
+		break;
+	case 1:
+		V(st)->snare.set_frequency(transpose(note));
+		V(st)->snare.set_tone(ua);
+		V(st)->snare.set_snappy(ub);
+		V(st)->snare.set_decay(dec);
+		break;
+	case 3:
+		V(st)->fm.set_frequency(static_cast<uint16_t>(clampi((note - (24 << 7)) * 65535 / (72 << 7), 0, 65535)));
+		V(st)->fm.set_fm_amount(ua);
+		V(st)->fm.set_noise(ub);
+		V(st)->fm.set_decay(dec);
+		break;
+	}
+}
+
+extern "C" void ext_render(void *st, int kind, int strike, short *out, int n)
+{
+	GateFlags gate[64];
+	if (n > 64)
+		n = 64;
+	for (int i = 0; i < n; i++)
+		gate[i] = GATE_FLAG_LOW;
+	if (strike)
+		gate[0] = GATE_FLAG_HIGH | GATE_FLAG_RISING;
+	switch (kind) {
+	case 0: V(st)->bass.Process(gate, out, n); break;
+	case 1: V(st)->snare.Process(gate, out, n); break;
+	case 2: V(st)->hat.Process(gate, out, n); break;
+	case 3: V(st)->fm.Process(gate, out, n); break;
+	}
+}
diff --git a/tools/machines/macro/sheep.h b/tools/machines/macro/sheep.h
new file mode 100644
index 0000000..137d39e
--- /dev/null
+++ b/tools/machines/macro/sheep.h
@@ -0,0 +1,157 @@
+/*
+ * SHEEP : the wavetable oscillator of Sheep, the alternative Tides firmware by Emilie Gillet (MIT, repository
+ * pichenettes/eurorack, tides/generator.cc, ProcessWavetable, the WAVETABLE_HACK build).
+ *
+ * This file is our code: a free-running voice, with Tides' clock, PLL and bank-on-clock behaviour removed (the bank
+ * is a parameter). The arithmetic is the one of ProcessWavetable, line for line, so the output is the same
+ * samples; tools/emu/sheep_ref.cc and tools/check_sheep_host.sh prove it against the original Generator.
+ * The tables (tides/resources.cc: wt_waves, ws_smooth_bipolar_fold, lut_cutoff, lut_increments) are compiled as is.
+ *
+ * Rate: 48 kHz, the Model:Cycles' own rate (Tides' tables are made for 48 kHz): no resampling.
+ * Pitch: 1/128 semitone, 440 Hz at 69, the Cycles' convention (Tides' lut_increments is built the same way).
+ * Integer only, no FPU: about 4 table reads and 8 multiplies per output sample, times the 4x oversampling.
+ */
+#ifndef MC_SHEEP_H_
+#define MC_SHEEP_H_
+
+#include <stdint.h>
+
+#include "stmlib/utils/dsp.h"
+#include "tides/resources.h"
+
+namespace sheep {
+
+using namespace tides;  // the resource tables of tides/resources.h
+
+/* Tides' 4x oversampling decimator weights (generator.cc, kDownsampleCoefficient) */
+static const int32_t kDownsample[4] = { 17162, 19069, 17162, 12140 };
+
+const int kBanks = 3;
+const int kWaveSize = 257;
+
+class Voice {
+ public:
+  void Init() {
+    phase_ = 0;
+    x_ = y_ = 0;
+    lp_[0] = lp_[1] = 0;
+    first_ = true;
+    snap_ = true;
+  }
+
+  /* host proof only: start the position at 0 and glide, as the zeroed Tides Generator does */
+  void set_snap(bool snap) { snap_ = snap; }
+
+  /* A trig restarts the cycle, as a gate edge does on Tides. */
+  void Strike() { phase_ = 0; }
+
+  /* pitch  : note in 1/128 semitone (Tides' own pitch_, i.e. already including its +1 octave if you want parity)
+   * x, y   : position in the wave map, -32768..32767 (Tides' SLOPE and SHAPE)
+   * fold   : -32768..32767 (Tides' SMOOTHNESS): above 0 wavefolder, below 0 low-pass filter
+   * bank   : 0 additive harmonics, 1 PWM-ish, 2 Braids' WMAP waves
+   * out    : size samples, 16 bit */
+  void Render(int pitch, int x, int y, int fold, int bank, int16_t* out, int size) {
+    uint32_t phase_increment = PhaseIncrement(pitch);
+
+    /* The grid is 8x8 rather than 9x9, so the position is scaled by 7/8. */
+    uint16_t target_x = static_cast<uint16_t>(x + 32768);
+    target_x = target_x * 57344 >> 16;
+    uint16_t target_y = static_cast<uint16_t>(y + 32768);
+    target_y = target_y * 57344 >> 16;
+    if (first_ && snap_) {  /* no glide from 0 on the first block */
+      x_ = target_x;
+      y_ = target_y;
+    }
+    first_ = false;
+    uint16_t px = x_, py = y_;
+    /* unsigned division, as in Tides (size_t): a falling position floors instead of truncating */
+    uint16_t x_increment = static_cast<uint32_t>(target_x - px) / static_cast<uint32_t>(size);
+    uint16_t y_increment = static_cast<uint32_t>(target_y - py) / static_cast<uint32_t>(size);
+
+    int32_t wf_gain = fold > 0 ? fold : 0;
+    wf_gain = wf_gain * wf_gain >> 15;
+
+    int32_t frequency = CutoffFrequency(pitch, fold);
+    int32_t f_a = lut_cutoff[frequency >> 7] >> 16;
+    int32_t f_b = lut_cutoff[(frequency >> 7) + 1] >> 16;
+    int32_t f = f_a + ((f_b - f_a) * (frequency & 0x7f) >> 7);
+    int32_t lp0 = lp_[0], lp1 = lp_[1];
+
+    const int16_t* bank_base = wt_waves + bank * 64 * kWaveSize - (bank & 2) * 4 * kWaveSize;
+    uint32_t phase = phase_;
+    while (size--) {
+      px += x_increment;
+      py += y_increment;
+      uint16_t x_integral = px >> 13;
+      uint16_t y_integral = py >> 13;
+      const int16_t* wave_1 = &bank_base[(x_integral + y_integral * 8) * kWaveSize];
+      const int16_t* wave_2 = wave_1 + kWaveSize * 8;
+      uint16_t x_fractional = px << 3;
+      int32_t y_fractional = (py << 2) & 0x7fff;
+
+      int32_t s = 0;
+      for (int32_t subsample = 0; subsample < 4; ++subsample) {
+        int32_t y_1 = stmlib::Crossfade(wave_1, wave_1 + kWaveSize, phase << 1, x_fractional);
+        int32_t y_2 = stmlib::Crossfade(wave_2, wave_2 + kWaveSize, phase << 1, x_fractional);
+        int32_t y_mix = y_1 + ((y_2 - y_1) * y_fractional >> 15);
+        int32_t folded = stmlib::Interpolate1022(ws_smooth_bipolar_fold, (y_mix + 32768) << 16);
+        y_mix = y_mix + ((folded - y_mix) * wf_gain >> 15);
+        s += y_mix * kDownsample[subsample];
+        phase += (phase_increment >> 3);
+      }
+      lp0 += f * ((s >> 16) - lp0) >> 15;
+      lp1 += f * (lp0 - lp1) >> 15;
+      *out++ = static_cast<int16_t>(lp1);
+    }
+    phase_ = phase;
+    x_ = px;
+    y_ = py;
+    lp_[0] = lp0;
+    lp_[1] = lp1;
+  }
+
+ private:
+  static uint32_t PhaseIncrement(int pitch) {
+    int num_shifts = 0;
+    const int kOct = 12 * 128;
+    if (pitch < 0) pitch = 0;
+    if (pitch > 120 << 7) pitch = 120 << 7;  /* Tides clamps pitch_ to 0..120 semitones */
+    while (pitch >= kOct) {
+      pitch -= kOct;
+      ++num_shifts;
+    }
+    uint32_t a = lut_increments[pitch >> 4];
+    uint32_t b = lut_increments[(pitch >> 4) + 1];
+    uint32_t inc = a + ((b - a) * (pitch & 0xf) >> 4);
+    return inc << num_shifts;
+  }
+
+  static int32_t CutoffFrequency(int pitch, int smoothness) {
+    int32_t frequency;
+    if (pitch < 0) pitch = 0;
+    if (pitch > 120 << 7) pitch = 120 << 7;
+    if (smoothness > 0) {
+      frequency = 256 << 7;
+    } else if (smoothness > -16384) {
+      int32_t start = pitch + (36 << 7);
+      int32_t end = 256 << 7;
+      frequency = start + ((end - start) * (smoothness + 16384) >> 14);
+    } else {
+      int32_t start = pitch - (36 << 7);
+      int32_t end = pitch + (36 << 7);
+      frequency = start + ((end - start) * (smoothness + 32768) >> 14);
+    }
+    frequency += 32768;
+    return frequency < 0 ? 0 : frequency;
+  }
+
+  uint32_t phase_;
+  uint16_t x_, y_;
+  int32_t lp_[2];
+  bool first_;
+  bool snap_;
+};
+
+}  // namespace sheep
+
+#endif  // MC_SHEEP_H_
diff --git a/tools/machines/macro/sheep_glue.cc b/tools/machines/macro/sheep_glue.cc
new file mode 100644
index 0000000..d2ee909
--- /dev/null
+++ b/tools/machines/macro/sheep_glue.cc
@@ -0,0 +1,52 @@
+/*
+ * SHEEP A, B, C as MACRO models (notes/74, notes/75): the wavetable oscillator of Sheep (Emilie Gillet, MIT, Tides
+ * firmware), one bank per model. Our voice is sheep.h, proved sample for sample against the original code.
+ *
+ * Knobs: COLOR (a) = X in the wave map, SWEEP (b) = Y, CONTOUR (c) = wavefolder amount (0: none), PITCH = the note.
+ * Only compiled with MC_SHEEP: its tables are about 96 KB, which the OS image has no room for yet (notes/75 §2).
+ */
+#ifdef MC_SHEEP
+#include <new>
+
+#include "sheep.h"
+#include "voices.h"
+
+static_assert(sizeof(sheep::Voice) <= EXT_BYTES, "EXT_BYTES too small for the Sheep voice");
+
+struct SheepState {
+	sheep::Voice v;
+	int note, x, y, fold;
+};
+
+static inline SheepState *S(void *st) { return reinterpret_cast<SheepState *>(st); }
+
+extern "C" void ext_init(void *st, int kind)
+{
+	if (kind < 4)
+		return;
+	new (st) SheepState;
+	S(st)->v.Init();
+	S(st)->note = 60 << 7;
+	S(st)->x = S(st)->y = S(st)->fold = 0;
+}
+
+extern "C" void ext_set(void *st, int kind, int note, int a, int b, int c, int decay)
+{
+	(void)decay;
+	if (kind < 4)
+		return;
+	S(st)->note = note;
+	S(st)->x = (a - 16383) * 2;
+	S(st)->y = (b - 16383) * 2;
+	S(st)->fold = c * 32767 / 32766;                 /* 0 .. 32767: fold, no filtering */
+}
+
+extern "C" void ext_render(void *st, int kind, int strike, short *out, int n)
+{
+	if (kind < 4)
+		return;
+	if (strike)
+		S(st)->v.Strike();
+	S(st)->v.Render(S(st)->note, S(st)->x, S(st)->y, S(st)->fold, kind - 4, out, n);
+}
+#endif
diff --git a/tools/machines/macro/voices.h b/tools/machines/macro/voices.h
new file mode 100644
index 0000000..15cc3ea
--- /dev/null
+++ b/tools/machines/macro/voices.h
@@ -0,0 +1,30 @@
+/*
+ * Voices of MACRO that are not Braids models (notes/74, notes/75): the drums of Peaks and the wavetable oscillator of
+ * Sheep, all by Emilie Gillet (MIT). Each one lives in its own translation unit (peaks_glue.cc, sheep_glue.cc): the
+ * resource headers of Braids, Peaks and Tides define the same macro names (LUT_SVF_CUTOFF ...) with different values
+ * and cannot be included together.
+ *
+ * The voice state is an opaque block of EXT_BYTES bytes inside the track; the glue checks its own size.
+ * kind: 0 BASS DRUM, 1 SNARE DRUM, 2 HI-HAT, 3 FM DRUM (Peaks) ; 4, 5, 6 SHEEP bank A, B, C.
+ */
+#ifndef MC_VOICES_H_
+#define MC_VOICES_H_
+
+#define EXT_BYTES   256
+#define EXT_PEAKS   4                                /* kinds 0..3 */
+#ifdef MC_SHEEP
+#define EXT_KINDS   7
+#else
+#define EXT_KINDS   4
+#endif
+
+extern "C" {
+/* (re)initialise the voice of this kind */
+void ext_init(void *st, int kind);
+/* note: 1/128 semitone, 440 Hz at 69 ; a, b, c: COLOR (+ envelope), SWEEP, CONTOUR in 0..32766 ; decay: DECAY 0..127 */
+void ext_set(void *st, int kind, int note, int a, int b, int c, int decay);
+/* n samples (16 bit, full scale) ; strike: a trig happens at the first sample */
+void ext_render(void *st, int kind, int strike, short *out, int n);
+}
+
+#endif
