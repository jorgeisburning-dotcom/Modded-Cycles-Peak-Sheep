+// Host proof for the Peaks glue (tools/machines/macro/peaks_glue.cc): the same drum, driven directly with the
+// parameter values the glue is documented to set, against ext_render. Build: tools/check_peaks_host.sh <eurorack>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include "peaks/drums/bass_drum.h"
+#include "peaks/drums/snare_drum.h"
+#include "peaks/drums/fm_drum.h"
+#include "peaks/drums/high_hat.h"
+#include "stmlib/utils/random.h"
+#include "voices.h"
+
+using namespace peaks;
+static int bad = 0;
+
+template <class D> static void run_ref(D &d, int blocks, short *out) {
+  GateFlags g[32];
+  for (int b = 0; b < blocks; ++b) {
+    for (int i = 0; i < 32; ++i) g[i] = (b == 0 && i == 0) ? (GATE_FLAG_HIGH | GATE_FLAG_RISING) : GATE_FLAG_LOW;
+    d.Process(g, out + b * 32, 32);
+  }
+}
+
+int main() {
+  // Direct comparison per kind
+  const int notes[] = {50 << 7, 60 << 7, (67 << 7) + 40};
+  const int ks[] = {0, 8000, 16383, 25000, 32766};
+  const int decs[] = {0, 40, 127};
+  static short r[200 * 32], m[200 * 32];
+  alignas(16) static unsigned char st[EXT_BYTES];
+  long checked = 0, loud = 0;
+  for (int kind = 0; kind < 4; ++kind)
+    for (unsigned n = 0; n < 3; ++n)
+      for (unsigned ia = 0; ia < 5; ++ia)
+        for (unsigned ib = 0; ib < 5; ib += 2)
+          for (unsigned id = 0; id < 3; ++id) {
+            int note = notes[n] & 0x3fff, a = ks[ia], b = ks[ib], dec = decs[id];
+            stmlib::Random::Seed(0x12345678 + kind);  // the drums share one noise generator: same start for both runs
+            memset(st, 0, sizeof st);
+            ext_init(st, kind);
+            ext_set(st, kind, note, a, b, 0, dec);
+            for (int bl = 0; bl < 200; ++bl) ext_render(st, kind, bl == 0, m + bl * 32, 32);
+            uint16_t ua = a * 2, ub = b * 2, ud = dec * 516;
+            int d7 = note - (60 << 7); d7 = d7 < -(7 << 7) ? -(7 << 7) : (d7 > (7 << 7) ? 7 << 7 : d7);
+            int16_t tr = (int16_t)(d7 * 32768 / 896 < -32767 ? -32767 : (d7 * 32768 / 896 > 32767 ? 32767 : d7 * 32768 / 896));
+            stmlib::Random::Seed(0x12345678 + kind);
+            if (kind == 0) { static BassDrum d; memset((void*)&d, 0, sizeof d); d.Init(); d.set_frequency(tr); d.set_tone(ua); d.set_punch(ub); d.set_decay(ud); run_ref(d, 200, r); }
+            if (kind == 1) { static SnareDrum d; memset((void*)&d, 0, sizeof d); d.Init(); d.set_frequency(tr); d.set_tone(ua); d.set_snappy(ub); d.set_decay(ud); run_ref(d, 200, r); }
+            if (kind == 2) { static HighHat d; memset((void*)&d, 0, sizeof d); d.Init(); run_ref(d, 200, r); }
+            if (kind == 3) {
+              static FmDrum d; memset((void*)&d, 0, sizeof d); d.Init(); d.set_sd_range(false);
+              int fr = (note - (24 << 7)) * 65535 / (72 << 7); fr = fr < 0 ? 0 : (fr > 65535 ? 65535 : fr);
+              d.set_frequency((uint16_t)fr); d.set_fm_amount(ua); d.set_noise(ub); d.set_decay(ud); run_ref(d, 200, r);
+            }
+            ++checked;
+            if (memcmp(r, m, sizeof r)) { ++bad; printf("FAIL kind=%d note=%d a=%d b=%d dec=%d\n", kind, note, a, b, dec); }
+            int peak = 0; for (int i = 0; i < 200 * 32; ++i) { int v = abs(m[i]); if (v > peak) peak = v; }
+            if (peak > 2000) ++loud;
+          }
+  printf("%ld cases, %ld with a clear signal (peak > 2000), %d mismatch(es)\n", checked, loud, bad);
+  return bad != 0;
+}
diff --git a/tools/emu/sheep_ref.cc b/tools/emu/sheep_ref.cc
new file mode 100644
index 0000000..615823c
--- /dev/null
+++ b/tools/emu/sheep_ref.cc
@@ -0,0 +1,74 @@
+// Host proof for the SHEEP voice (tools/machines/macro/sheep.h): the original Tides Generator, built with
+// WAVETABLE_HACK (= Sheep), against sheep::Voice, sample for sample, free-running, 16-sample blocks.
+// Build and run: tools/check_sheep_host.sh <path to a pichenettes/eurorack checkout>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include "tides/generator.h"
+#include "sheep.h"
+
+using namespace tides;
+
+static Generator g_ref;  // static storage: zeroed, like the global Generator on the module
+
+static bool run_case(int pitch, int x, int y, int fold, int bank, int blocks) {
+  memset(&g_ref, 0, sizeof(g_ref));  // Init() does not clear the glide position: start from the zeroed state of a fresh module
+  g_ref.Init();
+  g_ref.set_range(GENERATOR_RANGE_HIGH);
+  g_ref.set_sync(false);
+  g_ref.set_pitch(pitch);
+  g_ref.set_shape(y);
+  g_ref.set_slope(x);
+  g_ref.set_smoothness(fold);
+  // GeneratorMode is the bank index in the WAVETABLE_HACK build: AD = 0, LOOPING = 1, AR = 2
+  g_ref.set_mode(static_cast<GeneratorMode>(bank));
+  const int n = blocks * kBlockSize;
+  std::vector<int> ref, mine(n);
+  for (int i = 0; i < n + 64; ++i) {
+    ref.push_back(g_ref.Process(0).bipolar);
+    if (((i + 1) % kBlockSize) == 0) g_ref.Process();
+  }
+
+  sheep::Voice v;
+  v.Init();
+  v.set_snap(false);
+  std::vector<int16_t> out(kBlockSize);
+  for (int b = 0; b < blocks; ++b) {
+    // pitch_ inside Tides is the pitch we gave plus one octave
+    v.Render(pitch + 12 * 128, x, y, fold, bank, out.data(), kBlockSize);
+    for (int i = 0; i < (int)kBlockSize; ++i) mine[b * kBlockSize + i] = out[i];
+  }
+  // Tides' double buffer plays three blocks of silence before the first rendered one: the port starts 48 samples earlier
+  const int lag = 3 * kBlockSize;
+  bool same = true;
+  int nonzero = 0;
+  for (int i = 0; i < n; ++i) {
+    if (ref[i + lag] != mine[i]) same = false;
+    if (mine[i]) ++nonzero;
+  }
+  if (same) {
+    printf("OK    pitch=%5d x=%6d y=%6d fold=%6d bank=%d  %d samples identical (%d non-zero)\n", pitch, x, y, fold, bank, n, nonzero);
+    return true;
+  }
+  int first = -1;
+  for (int i = 0; i < n; ++i) if (ref[i + lag] != mine[i]) { first = i; break; }
+  printf("FAIL  pitch=%5d x=%6d y=%6d fold=%6d bank=%d  first difference at sample %d (ref %d, port %d)\n", pitch, x, y, fold, bank, first, first < 0 ? 0 : ref[first + lag], first < 0 ? 0 : mine[first]);
+  return false;
+}
+
+int main() {
+  int bad = 0;
+  const int pitches[] = {24 * 128, 48 * 128, 57 * 128 + 37, 69 * 128, 84 * 128 + 5, 100 * 128};
+  const int xs[] = {-32768, -9000, 0, 12345, 32767};
+  const int folds[] = {-32768, -20000, -8000, 0, 9000, 32767};
+  for (int bank = 0; bank < 3; ++bank)
+    for (unsigned p = 0; p < sizeof(pitches) / sizeof(*pitches); ++p)
+      for (unsigned k = 0; k < sizeof(xs) / sizeof(*xs); ++k)
+        for (unsigned f = 0; f < sizeof(folds) / sizeof(*folds); ++f) {
+          int x = xs[k], y = xs[(k * 2 + p) % 5];
+          if (!run_case(pitches[p] - 12 * 128, x, y, folds[f], bank, 40)) ++bad;
+        }
+  printf(bad ? "%d case(s) FAILED\n" : "all cases identical\n", bad);
+  return bad != 0;
+}
