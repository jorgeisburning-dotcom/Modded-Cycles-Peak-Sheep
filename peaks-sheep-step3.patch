diff --git a/tools/machines/macro/peaks_glue.cc b/tools/machines/macro/peaks_glue.cc
index c8ddaed..8bad5f5 100644
--- a/tools/machines/macro/peaks_glue.cc
+++ b/tools/machines/macro/peaks_glue.cc
@@ -53,6 +53,9 @@ extern "C" void ext_init(void *st, int kind)
 	case 1: new (&V(st)->snare) SnareDrum; V(st)->snare.Init(); break;
 	case 2: new (&V(st)->hat) HighHat; V(st)->hat.Init(); break;
 	case 3: new (&V(st)->fm) FmDrum; V(st)->fm.Init(); V(st)->fm.set_sd_range(false); break;
+#ifdef MC_SHEEP
+	default: sheep_init(st, kind); break;
+#endif
 	}
 }
 
@@ -80,11 +83,22 @@ extern "C" void ext_set(void *st, int kind, int note, int a, int b, int c, int d
 		V(st)->fm.set_noise(ub);
 		V(st)->fm.set_decay(dec);
 		break;
+#ifdef MC_SHEEP
+	default:
+		sheep_set(st, kind, note, a, b, c, decay);
+		break;
+#endif
 	}
 }
 
 extern "C" void ext_render(void *st, int kind, int strike, short *out, int n)
 {
+#ifdef MC_SHEEP
+	if (kind >= EXT_PEAKS) {
+		sheep_render(st, kind, strike, out, n);
+		return;
+	}
+#endif
 	GateFlags gate[64];
 	if (n > 64)
 		n = 64;
@@ -97,5 +111,7 @@ extern "C" void ext_render(void *st, int kind, int strike, short *out, int n)
 	case 1: V(st)->snare.Process(gate, out, n); break;
 	case 2: V(st)->hat.Process(gate, out, n); break;
 	case 3: V(st)->fm.Process(gate, out, n); break;
+#ifdef MC_SHEEP
+#endif
 	}
 }
diff --git a/tools/machines/macro/sheep_glue.cc b/tools/machines/macro/sheep_glue.cc
index d2ee909..85adcad 100644
--- a/tools/machines/macro/sheep_glue.cc
+++ b/tools/machines/macro/sheep_glue.cc
@@ -18,9 +18,11 @@ struct SheepState {
 	int note, x, y, fold;
 };
 
+static_assert(sizeof(SheepState) <= EXT_BYTES, "EXT_BYTES too small for the Sheep state");
+
 static inline SheepState *S(void *st) { return reinterpret_cast<SheepState *>(st); }
 
-extern "C" void ext_init(void *st, int kind)
+extern "C" void sheep_init(void *st, int kind)
 {
 	if (kind < 4)
 		return;
@@ -30,7 +32,7 @@ extern "C" void ext_init(void *st, int kind)
 	S(st)->x = S(st)->y = S(st)->fold = 0;
 }
 
-extern "C" void ext_set(void *st, int kind, int note, int a, int b, int c, int decay)
+extern "C" void sheep_set(void *st, int kind, int note, int a, int b, int c, int decay)
 {
 	(void)decay;
 	if (kind < 4)
@@ -41,7 +43,7 @@ extern "C" void ext_set(void *st, int kind, int note, int a, int b, int c, int d
 	S(st)->fold = c * 32767 / 32766;                 /* 0 .. 32767: fold, no filtering */
 }
 
-extern "C" void ext_render(void *st, int kind, int strike, short *out, int n)
+extern "C" void sheep_render(void *st, int kind, int strike, short *out, int n)
 {
 	if (kind < 4)
 		return;
